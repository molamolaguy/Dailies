<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dailies" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#121118</item>
        <item name="android:colorBackground">#121118</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Light theme for the game player, so pages see prefers-color-scheme: light. -->
    <style name="Theme.Dailies.Light" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">#FEF7FF</item>
        <item name="android:colorBackground">#FEF7FF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
