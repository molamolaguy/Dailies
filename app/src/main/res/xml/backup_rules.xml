<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older Auto Backup: same policy as data_extraction_rules.xml. The local .bak copy is
     left out: it would double the size against Android's 25 MB backup quota (over it, nothing is backed up). -->
<full-backup-content>
    <include domain="file" path="hub_state.json" />
    <include domain="sharedpref" path="." />
</full-backup-content>
