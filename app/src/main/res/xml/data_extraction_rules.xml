<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the hub data and settings, never game-site logins/cookies or caches. The local
     .bak copy is left out so a large history stays within the 25 MB backup quota. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="hub_state.json" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="dailes_auto_backup.xml" />
        <exclude domain="sharedpref" path="dailes_permissions.xml" />
        <exclude domain="sharedpref" path="dailes_notifier.xml" />
        <exclude domain="sharedpref" path="dailes_reminders.xml" />
        <exclude domain="sharedpref" path="dailies_crash_log.xml" />
        <exclude domain="sharedpref" path="dailies_game_recheck.xml" />
        <exclude domain="sharedpref" path="androidx.work.util.preferences.xml" />
        <exclude domain="sharedpref" path="androidx.work.util.id.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="hub_state.json" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="dailes_auto_backup.xml" />
        <exclude domain="sharedpref" path="dailes_permissions.xml" />
        <exclude domain="sharedpref" path="dailes_notifier.xml" />
        <exclude domain="sharedpref" path="dailes_reminders.xml" />
        <exclude domain="sharedpref" path="dailies_crash_log.xml" />
        <exclude domain="sharedpref" path="dailies_game_recheck.xml" />
        <exclude domain="sharedpref" path="androidx.work.util.preferences.xml" />
        <exclude domain="sharedpref" path="androidx.work.util.id.xml" />
    </device-transfer>
</data-extraction-rules>
